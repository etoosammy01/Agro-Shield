# Copy this file to .env and replace every placeholder.
# Run the backend from the backend/ directory so godotenv finds .env.

# Application
APP_ENV=development
PORT=8080

# Forwarded client-IP headers are ignored unless a reverse proxy is explicitly
# trusted. Set both values only when the app is reached exclusively through a
# proxy that overwrites X-Forwarded-For / X-Forwarded-Proto. Keep
# TRUST_PROXY_HEADERS unset for direct access.
# TRUST_PROXY_HEADERS=true
# TRUSTED_PROXY_CIDRS=10.0.0.0/8,192.168.0.0/16

# PostgreSQL connection string (database must exist and be reachable)
DATABASE_URL=postgres://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_DB_NAME?sslmode=disable

# Optional connection-pool limits. Defaults: 20 open, 10 idle, 30m lifetime,
# 5m idle timeout. Keep DB_MAX_OPEN_CONNS within the database plan's limits.
# DB_MAX_OPEN_CONNS=20
# DB_MAX_IDLE_CONNS=10
# DB_CONN_MAX_LIFETIME=30m
# DB_CONN_MAX_IDLE_TIME=5m

# Required AI configuration for the application to start
GEMINI_API_KEY=replace_with_your_gemini_api_key
GROQ_API_KEY=replace_with_your_groq_api_key
# Optional backup learning provider
OPENROUTER_API_KEY=

# Flutterwave TEST credentials only for sandbox testing
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-replace_me
# Set this same secret hash in the Flutterwave test dashboard webhook settings
FLUTTERWAVE_SECRET_HASH=replace_with_a_long_random_webhook_secret
# Local browser callback works for testing checkout redirects; webhooks need a public HTTPS URL
PAYMENT_REDIRECT_URL=http://localhost:8080/payments/callback
# Funding methods offered on hosted checkout. Sent to Flutterwave explicitly so
# card vs bank transfer does not depend on the dashboard's settings.
FLUTTERWAVE_PAYMENT_OPTIONS=card,banktransfer

# Comma-separated database user IDs allowed to approve wallet withdrawals
# and wallet-to-wallet transfers
WALLET_ADMIN_USER_IDS=1

# How long a wallet funding attempt may stay unsettled before it is listed on
# the admin page for an operator to investigate. Reporting only: no deposit is
# ever credited, expired or refunded automatically. Whole hours; default 24.
WALLET_STALE_DEPOSIT_HOURS=24

# Integration tests only. When this is set, `go test ./internal/repository/`
# runs the wallet tests against the database named here; when it is unset they
# skip. Use a throwaway database — the tests create and delete users.
# TEST_DATABASE_URL=postgres://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_TEST_DB_NAME?sslmode=disable

# Platform commission on marketplace sales, as a percentage of the order total.
# Taken from the seller's payout and recorded in the platform_revenue ledger,
# which no wallet is credited from. Leave empty or 0 to switch commission off;
# at most two decimal places.
COMMISSION_PERCENT=

# One-time passcode delivery and verification.
# Setting the API key enables OTP.dev; without a key, codes use the development log.
OTPDEV_API_KEY=
# Sender, template ID, and API URL are built into internal/config/config.go.
# The OTP.dev SMS template must contain {code}.
# Optional override: use "log" for development or "otpdev" to require SMS.
# SMS_PROVIDER=log
