# Copy this file to .env and replace every placeholder.
# Run the backend from the backend/ directory so godotenv finds .env.

# Application
APP_ENV=development
PORT=8080

# PostgreSQL connection string (database must exist and be reachable)
DATABASE_URL=postgres://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_DB_NAME?sslmode=disable

# Required AI configuration for the application to start
GEMINI_API_KEY=replace_with_your_gemini_api_key
GROQ_API_KEY=replace_with_your_groq_api_key
# Optional backup learning provider
OPENROUTER_API_KEY=

# Flutterwave TEST credentials only for sandbox testing
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-replace_me
# Set this same secret hash in the Flutterwave test dashboard webhook settings
FLUTTERWAVE_SECRET_HASH=replace_with_a_long_random_webhook_secret
# Local browser callback works for testing checkout redirects; webhooks need a public HTTPS URL
PAYMENT_REDIRECT_URL=http://localhost:8080/payments/callback
# Funding methods offered on hosted checkout. Sent to Flutterwave explicitly so
# card vs bank transfer does not depend on the dashboard's settings.
FLUTTERWAVE_PAYMENT_OPTIONS=card,banktransfer

# Comma-separated database user IDs allowed to approve wallet withdrawals
# and wallet-to-wallet transfers
WALLET_ADMIN_USER_IDS=1

# Platform commission on marketplace sales, as a percentage of the order total.
# Taken from the seller's payout and recorded in the platform_revenue ledger,
# which no wallet is credited from. Leave empty or 0 to switch commission off;
# at most two decimal places.
COMMISSION_PERCENT=

# One-time passcode delivery.
# "log" prints codes to the server log — the default, so local development
# needs no vendor account. Use "termii" in production.
SMS_PROVIDER=log
# Required when SMS_PROVIDER=termii
TERMII_API_KEY=
# The approved sender ID shown to recipients, e.g. AgroShield
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com
